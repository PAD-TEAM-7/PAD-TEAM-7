{
  "info": {
    "name": "PAD Lab 4 - player-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Current Lab 4 deployment (Gateway 28080, Broker 28601, Discovery 28500). FIRST run scripts/lab4-prepare-postman.py and import its PRIVATE environment. Run folders in order. Regenerate fixtures before repeating a collection. All requests assert their expected status. Removed service-only Gateway routes deliberately expect 404. Native gRPC examples: postman/grpc/README.md. Never export real environment credentials into Git."
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:28080"
    },
    {
      "key": "broker",
      "value": "http://localhost:28601"
    },
    {
      "key": "discovery",
      "value": "http://localhost:28500"
    }
  ],
  "item": [
    {
      "name": "player-service",
      "item": [
        {
          "name": "01 Register a fresh additional player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/players/register",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\");",
                  "pm.environment.set(\"newUsername\", \"pm_\" + id.slice(0, 12));",
                  "pm.environment.set(\"newEmail\", id + \"@postman.invalid\");",
                  "pm.environment.set(\"newPassword\", \"Demo_\" + id + \"A9!\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const data = pm.response.json();",
                  "pm.test(\"newPlayerId returned\", () => pm.expect(data.player_id).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"newPlayerId\", data.player_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Login real fixture player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/players/login",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{playerEmail}}\",\n  \"password\": \"{{playerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const data = pm.response.json();",
                  "pm.test(\"playerToken returned\", () => pm.expect(data.access_token).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"playerToken\", data.access_token);",
                  "pm.test(\"playerRefreshToken returned\", () => pm.expect(data.refresh_token).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"playerRefreshToken\", data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Public signing keys",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/auth/jwks",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"RSA keys\", () => pm.expect(pm.response.json().keys).to.be.an(\"array\").and.not.empty);"
                ]
              }
            }
          ]
        },

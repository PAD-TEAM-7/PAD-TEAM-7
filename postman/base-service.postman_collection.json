  {
   "name": "5. Idempotency and errors",
   "item": [
    {
     "name": "Replayed upgrade returns the stored result",
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "// One key, sent twice: the second call must not upgrade again.",
         "pm.collectionVariables.set('replay_key', pm.variables.replaceIn('{{$guid}}'));",
         "pm.sendRequest({ url: pm.collectionVariables.get('base_url') + '/bases/' + pm.collectionVariables.get('base_id') + '/upgrade',",
         "  method: 'POST',",
         "  header: { 'Content-Type': 'application/json', 'Idempotency-Key': pm.collectionVariables.get('replay_key'),",
         "            'Authorization': 'Bearer ' + pm.collectionVariables.get('player_token') },",
         "  body: { mode: 'raw', raw: JSON.stringify({ player_id: pm.collectionVariables.get('player_id') }) } },",
         "  (err, res) => pm.collectionVariables.set('first_level', res.json().level));"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status 200', () => pm.response.to.have.status(200));",
         "pm.test('identical level to the first call \u2014 nothing upgraded twice', () =>",
         "  pm.expect(pm.response.json().level).to.eql(Number(pm.collectionVariables.get('first_level'))));"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Idempotency-Key",
        "value": "{{replay_key}}"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"player_id\": \"{{player_id}}\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "url": {
       "raw": "{{base_url}}/bases/{{base_id}}/upgrade",
       "host": [

  {
   "name": "1. Base lifecycle",
   "item": [
    {
     "name": "Create base (Game Service)",
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "// A fresh lobby every run, so the flow never hits BASE_ALREADY_EXISTS.",
         "pm.collectionVariables.set('lobby_id', 'lobby-' + Date.now());"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status 201', () => pm.response.to.have.status(201));",
         "const base = pm.response.json();",
         "pm.collectionVariables.set('base_id', base.base_id);",
         "pm.test('starts at level 1', () => { pm.expect(base.level).to.eql(1); pm.expect(base.defense_rating).to.eql(10); });"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Idempotency-Key",
        "value": "{{$guid}}"
       }
      ],
      "url": {
       "raw": "{{base_url}}/bases",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "bases"
       ]
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{service_token}}",
         "type": "string"
        }
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"lobby_id\": \"{{lobby_id}}\",\n  \"home_room_id\": \"faf-cab\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "description": "Service token only \u2014 a player token is rejected with 403."
     }
    },
    {
     "name": "Get base state",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status 200', () => pm.response.to.have.status(200));",
         "pm.test('is the base we created', () => pm.expect(pm.response.json().base_id).to.eql(pm.collectionVariables.get('base_id')));"

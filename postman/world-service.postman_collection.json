{
  "info": {
    "name": "PAD TEAM 7 — World Service",
    "description": "World Service (section 4 of the CPR README), reached through the API gateway on :8080 (Lab 2). Run the folders in order (Collection Runner works).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{player_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "player_username",
      "value": ""
    },
    {
      "key": "other_username",
      "value": ""
    },
    {
      "key": "player_id",
      "value": ""
    },
    {
      "key": "other_player_id",
      "value": ""
    },
    {
      "key": "player_token",
      "value": ""
    },
    {
      "key": "other_player_token",
      "value": ""
    },
    {
      "key": "service_token",
      "value": ""
    },
    {
      "key": "lobby_id",
      "value": ""
    },
    {
      "key": "room_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health (prefixed route)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": {
          "raw": "{{gateway_url}}/world-service/api/v1/health",
          "host": [
            "{{gateway_url}}"
          ],
          "path": [
            "world-service",
            "api",
            "v1",
            "health"
          ]
        }
      }
    },

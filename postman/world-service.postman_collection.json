    {
      "name": "1. Generate",
      "item": [
        {
          "name": "Generate world (Game Service)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('lobby_id', 'lobby-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const w = pm.response.json();",
                  "pm.test('Block 1 open, 5 wings locked', () => { pm.expect(w.wings.filter(x => x.unlocked)).to.have.lengthOf(1); pm.expect(w.wings.filter(x => !x.unlocked)).to.have.lengthOf(5); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{service_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lobby_id\": \"{{lobby_id}}\",\n  \"university\": \"FAF\",\n  \"seed\": \"cab-survivors-2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/worlds",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "worlds"
              ]
            }
          }
        },
        {
          "name": "Generate again → 409 WORLD_ALREADY_EXISTS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code WORLD_ALREADY_EXISTS', () => pm.expect(pm.response.json().error.code).to.eql('WORLD_ALREADY_EXISTS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{service_token}}",
                  "type": "string"

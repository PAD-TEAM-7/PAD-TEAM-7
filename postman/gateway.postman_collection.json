{
  "info": {
    "name": "PAD TEAM 7 — API Gateway",
    "description": "The API gateway (Lab 2): routing, authentication at the gateway, WebSocket negotiation. Run the folders in order (Collection Runner works).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{player_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "player_username",
      "value": ""
    },
    {
      "key": "other_username",
      "value": ""
    },
    {
      "key": "player_id",
      "value": ""
    },
    {
      "key": "other_player_id",
      "value": ""
    },
    {
      "key": "player_token",
      "value": ""
    },
    {
      "key": "other_player_token",
      "value": ""
    },
    {
      "key": "service_token",
      "value": ""
    },
    {
      "key": "lobby_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Gateway",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('gateway', () => pm.expect(pm.response.json().service).to.eql('gateway'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/health",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Every service, through the gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('8 services ok', () => pm.expect(Object.values(pm.response.json().upstreams).filter(u => u.status === 'ok')).to.have.lengthOf(8));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/health/upstreams",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "health",
                "upstreams"
              ]
            }
          }
        },
        {
          "name": "Route table",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/gateway/routes",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "gateway",
                "routes"
              ]
            }
          }
        },
        {
          "name": "Unknown path → 404 ROUTE_NOT_FOUND",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code ROUTE_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('ROUTE_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/no-such-thing",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "no-such-thing"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "0. Auth (through the gateway)",
      "description": "Run first: the tokens are stored as collection variables and used by every other request.",
      "item": [
        {
          "name": "Register player",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('player_username', 'player_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{player_username}}\",\n  \"email\": \"{{player_username}}@faf.university\",\n  \"password\": \"correct-horse-battery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/players/register",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "players",
                "register"
              ]
            }
          }
        },
        {
          "name": "Log in player (real RS256 token from Player Service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('player_id', body.player_id);",
                  "pm.collectionVariables.set('player_token', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{player_username}}@faf.university\",\n  \"password\": \"correct-horse-battery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/players/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "players",
                "login"
              ]
            }
          }
        },
        {
          "name": "Register other",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('other_username', 'other_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{other_username}}\",\n  \"email\": \"{{other_username}}@faf.university\",\n  \"password\": \"correct-horse-battery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/players/register",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "players",
                "register"
              ]
            }
          }
        },
        {
          "name": "Log in other (real RS256 token from Player Service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('other_player_id', body.player_id);",
                  "pm.collectionVariables.set('other_player_token', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{other_username}}@faf.university\",\n  \"password\": \"correct-horse-battery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/players/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "players",
                "login"
              ]
            }
          }
        },
        {
          "name": "Service token (gateway test endpoint, as game-service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('service_token', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sub\": \"game-service\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/gateway/dev/tokens",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "gateway",
                "dev",
                "tokens"
              ]
            },
            "description": "Enabled by DEV_TOKENS=true (AUTH_DEV_TOKENS in deploy/.env). Player tokens come from the login above."
          }
        }
      ]
    },
    {
      "name": "2. Authentication at the gateway",
      "item": [
        {
          "name": "No token → 401 (never reaches the service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('error code UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));",
                  "pm.test('WWW-Authenticate', () => pm.response.to.have.header('WWW-Authenticate'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/courses",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "courses"
              ]
            }
          }
        },
        {
          "name": "Forged token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('error code UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not.a.valid-token",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/courses",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "courses"
              ]
            }
          }
        },
        {
          "name": "Forged X-Auth-* headers without a token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('error code UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "X-Auth-Kind",
                "value": "service"
              },
              {
                "key": "X-Auth-Subject",
                "value": "game-service"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/courses",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "courses"
              ]
            }
          }
        },
        {
          "name": "Real player token → Exam answers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/courses",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "courses"
              ]
            }
          }
        },
        {
          "name": "Real player token → Player Service answers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/players/{{player_id}}",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "players",
                "{{player_id}}"
              ]
            }
          }
        },
        {
          "name": "Real player token → Zombie Service answers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/zombie-types",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "zombie-types"
              ]
            }
          }
        },
        {
          "name": "Service token → service endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{service_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/players/{{player_id}}/passed",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "players",
                "{{player_id}}",
                "passed"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. WebSocket negotiation",
      "item": [
        {
          "name": "Create a lobby at Game Service",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('lobby_id', pm.response.json().lobby_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman lobby\",\n  \"university\": \"FAF\",\n  \"max_players\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/lobbies",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "lobbies"
              ]
            }
          }
        },
        {
          "name": "Negotiate → direct URL to Game",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('a WebSocket URL straight to Game', () => { pm.expect(body.protocol).to.eql('websocket'); pm.expect(body.url).to.match(/^ws:\\/\\/localhost:8002\\/ws\\/v1\\/lobbies\\//); });",
                  "pm.test('issued to this player', () => pm.expect(body.player_id).to.eql(pm.collectionVariables.get('player_id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/ws/v1/lobbies/{{lobby_id}}",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "ws",
                "v1",
                "lobbies",
                "{{lobby_id}}"
              ]
            }
          }
        },
        {
          "name": "Negotiate without a token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('error code UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/ws/v1/lobbies/{{lobby_id}}",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "ws",
                "v1",
                "lobbies",
                "{{lobby_id}}"
              ]
            }
          }
        },
        {
          "name": "Negotiate as a service → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403', () => pm.response.to.have.status(403));",
                  "pm.test('error code FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{service_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/ws/v1/lobbies/{{lobby_id}}",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "ws",
                "v1",
                "lobbies",
                "{{lobby_id}}"
              ]
            }
          }
        }
      ]
    }
  ]
}

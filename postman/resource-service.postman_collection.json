{
  "info": {
    "name": "PAD Lab 4 - resource-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Current Lab 4 deployment (Gateway 28080, Broker 28601, Discovery 28500). FIRST run scripts/lab4-prepare-postman.py and import its PRIVATE environment. Run folders in order. Regenerate fixtures before repeating a collection. All requests assert their expected status. Removed service-only Gateway routes deliberately expect 404. Native gRPC examples: postman/grpc/README.md. Never export real environment credentials into Git."
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:28080"
    },
    {
      "key": "broker",
      "value": "http://localhost:28601"
    },
    {
      "key": "discovery",
      "value": "http://localhost:28500"
    }
  ],
  "item": [
    {
      "name": "resource-service",
      "item": [
        {
          "name": "01 Real lobby-scoped balances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/players/{{playerId}}/resources?lobby_id={{lobbyId}}",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Real balances\", () => pm.expect(pm.response.json().resources).to.be.an(\"array\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Balances require player authentication",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/players/{{playerId}}/resources?lobby_id={{lobbyId}}",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pools are service-only (removed: 404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/pools",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Gateway removed route\", () => pm.expect(pm.response.json().error.code).to.eql(\"ROUTE_NOT_FOUND\"));"
                ]
              }
            }
          ]
        },

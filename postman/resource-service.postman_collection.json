    {"name":"Gather","event":[{"listen":"test","script":{"exec":["pm.test('status 200',()=>pm.response.to.have.status(200));","pm.test('credited',()=>pm.expect(pm.response.json().player_balance).to.have.length(2));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Idempotency-Key","value":"{{gatherKey}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"lobby_id\":\"{{lobbyId}}\",\"player_id\":\"{{playerId}}\",\"source_pool_id\":\"{{sourcePoolId}}\",\"items\":[{\"item_id\":\"metal-01\",\"count\":5},{\"item_id\":\"wood-01\",\"count\":10}],\"reason\":\"action_completed\",\"action_id\":\"action-postman\"}"},"url":"{{baseUrl}}/api/v1/transactions/gather"}},

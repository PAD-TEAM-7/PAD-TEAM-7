    {"name":"Compensate","event":[{"listen":"test","script":{"exec":["pm.test('status 200',()=>pm.response.to.have.status(200));","pm.test('compensated',()=>pm.expect(pm.response.json().status).to.eql('compensated'));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Idempotency-Key","value":"{{$guid}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"reason\":\"delivery_failed\"}"},"url":"{{baseUrl}}/api/v1/transactions/{{consumeTxId}}/compensate"}},

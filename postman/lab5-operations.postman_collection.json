{
  "info": {
    "name": "PAD Lab 5 operations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Broker craft sagas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{brokerAdminToken}}"
          }
        ],
        "url": "{{broker}}/v1/sagas",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Saga list\", () => pm.expect(pm.response.json().sagas).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject unauthenticated saga listing",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{broker}}/v1/sagas",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}

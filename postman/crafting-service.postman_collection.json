  {
   "name": "4. Idempotency and errors",
   "item": [
    {
     "name": "Replayed craft crafts nothing twice",
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "// One key, sent twice. The second call must return the first job, not a new one.",
         "pm.collectionVariables.set('replay_key', pm.variables.replaceIn('{{$guid}}'));",
         "pm.sendRequest({ url: pm.collectionVariables.get('crafting_url') + '/crafts', method: 'POST',",
         "  header: { 'Content-Type': 'application/json', 'Idempotency-Key': pm.collectionVariables.get('replay_key'),",
         "            'Authorization': 'Bearer ' + pm.collectionVariables.get('player_token') },",
         "  body: { mode: 'raw', raw: JSON.stringify({ player_id: pm.collectionVariables.get('player_id'),",
         "    recipe_id: 'recipe-energy-booster' }) } },",
         "  (err, res) => pm.collectionVariables.set('first_job_id', res.json().job_id));"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status 200 \u2014 a replay, not a fresh 201', () => pm.response.to.have.status(200));",
         "const body = pm.response.json();",
         "pm.test('flagged as replayed', () => pm.expect(body.replayed).to.be.true);",
         "pm.test('same job as the first call', () =>",
         "  pm.expect(body.job_id).to.eql(pm.collectionVariables.get('first_job_id')));"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Idempotency-Key",
        "value": "{{replay_key}}"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"player_id\": \"{{player_id}}\",\n  \"recipe_id\": \"recipe-energy-booster\"\n}",
       "options": {
        "raw": {

{
  "info": {
    "name": "PAD Lab 4 - crafting-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Current Lab 4 deployment (Gateway 28080, Broker 28601, Discovery 28500). FIRST run scripts/lab4-prepare-postman.py and import its PRIVATE environment. Run folders in order. Regenerate fixtures before repeating a collection. All requests assert their expected status. Removed service-only Gateway routes deliberately expect 404. Native gRPC examples: postman/grpc/README.md. Never export real environment credentials into Git."
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:28080"
    },
    {
      "key": "broker",
      "value": "http://localhost:28601"
    },
    {
      "key": "discovery",
      "value": "http://localhost:28500"
    }
  ],
  "item": [
    {
      "name": "crafting-service",
      "item": [
        {
          "name": "01 Recipe catalogue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Filter recipes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes?category=defense",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Recipe detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes/recipe-barricade-kit",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Available recipes - known service regression",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes/available?player_id={{playerId}}&lobby_id={{lobbyId}}&base_id={{baseId}}",
            "description": "Expected 200. Current release fails: Crafting requests Player profile with a service identity (403) and World /api/v1/wings?lobby_id=... (404; current World API is /api/v1/worlds/{lobbyId}/wings with player auth). Keep this assertion failing until the service integration is fixed; do not treat 403/404 as success."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Preview verifies real Resource balances",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes/recipe-barricade-kit/preview",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{playerId}}\",\n  \"lobby_id\": \"{{lobbyId}}\",\n  \"base_id\": \"{{baseId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Real materials verified\", () => pm.expect(pm.response.json().materials_verified).to.eql(true));",
                  "pm.test(\"Craftable\", () => pm.expect(pm.response.json().craftable).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Craft with real consumption and Player reward",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{craftKey}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/crafts",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{playerId}}\",\n  \"lobby_id\": \"{{lobbyId}}\",\n  \"base_id\": \"{{baseId}}\",\n  \"recipe_id\": \"recipe-barricade-kit\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"craftKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const data = pm.response.json();",
                  "pm.test(\"jobId returned\", () => pm.expect(data.job_id).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"jobId\", data.job_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Replay craft - same job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{craftKey}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/crafts",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{playerId}}\",\n  \"lobby_id\": \"{{lobbyId}}\",\n  \"base_id\": \"{{baseId}}\",\n  \"recipe_id\": \"recipe-barricade-kit\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Same job\", () => pm.expect(pm.response.json().job_id).to.eql(pm.environment.get(\"jobId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Job state",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/crafts/{{jobId}}",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Craft history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/crafts?player_id={{playerId}}&limit=10",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Another player's history is forbidden",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/crafts?player_id={{otherPlayerId}}",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Unknown recipe",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes/recipe-missing",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}

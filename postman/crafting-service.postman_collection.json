{
  "info": {
    "name": "PAD Lab 5 - crafting-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Lab 5 deployment (Gateway 28080, Broker 28601, Discovery 28500). FIRST run scripts/lab4-prepare-postman.py and import its PRIVATE environment. Run folders in order. Regenerate fixtures before repeating a collection. All requests assert their expected status. Removed service-only Gateway routes deliberately expect 404. Native gRPC examples: postman/grpc/README.md. Never export real environment credentials into Git."
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:28080"
    },
    {
      "key": "broker",
      "value": "http://localhost:28601"
    },
    {
      "key": "discovery",
      "value": "http://localhost:28500"
    }
  ],
  "item": [
    {
      "name": "crafting-service",
      "item": [
        {
          "name": "01 Recipe catalogue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Filter recipes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes?category=defense",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Recipe detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes/recipe-barricade-kit",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Preview verifies real Resource balances",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes/recipe-barricade-kit/preview",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{playerId}}\",\n  \"lobby_id\": \"{{lobbyId}}\",\n  \"base_id\": \"{{baseId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Real materials verified\", () => pm.expect(pm.response.json().materials_verified).to.eql(true));",
                  "pm.test(\"Craftable\", () => pm.expect(pm.response.json().craftable).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Start a real Crafting settlement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{craftKey}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/crafts",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{playerId}}\",\n  \"lobby_id\": \"{{lobbyId}}\",\n  \"base_id\": \"{{baseId}}\",\n  \"recipe_id\": \"recipe-barricade-kit\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"craftKey\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.variables.set(\"lab5CraftPolls\", 0);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 or 202\", () => pm.expect([201, 202].includes(pm.response.code)).to.eql(true));",
                  "if ([201, 202].includes(pm.response.code)) { const data = pm.response.json();",
                  "pm.test(\"jobId returned\", () => pm.expect(data.job_id).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"jobId\", data.job_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Replay craft - same job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{craftKey}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/crafts",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{playerId}}\",\n  \"lobby_id\": \"{{lobbyId}}\",\n  \"base_id\": \"{{baseId}}\",\n  \"recipe_id\": \"recipe-barricade-kit\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 or 202\", () => pm.expect([201, 202].includes(pm.response.code)).to.eql(true));",
                  "pm.test(\"Same job\", () => pm.expect(pm.response.json().job_id).to.eql(pm.environment.get(\"jobId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Poll the settlement outcome",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/crafts/{{jobId}}",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const job = pm.response.json();",
                  "const polls = Number(pm.variables.get(\"lab5CraftPolls\") || 0);",
                  "pm.test(\"Read the original job\", () => pm.expect(job.job_id).to.eql(pm.environment.get(\"jobId\")));",
                  "if (job.status === \"pending\" && polls < 10) {",
                  "  pm.variables.set(\"lab5CraftPolls\", polls + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.test(\"Craft completed\", () => pm.expect(job.status).to.eql(\"completed\"));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Craft history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/crafts?player_id={{playerId}}&limit=10",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Another player's history is forbidden",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/crafts?player_id={{otherPlayerId}}",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Unknown recipe",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes/recipe-missing",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lab 5 - eligible worker replicas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{discoveryToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{discovery}}/v1/instances",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const replicas = pm.response.json().instances.filter(instance => instance.service === \"crafting-service\" && instance.healthy && instance.lease_valid && !instance.removed);",
                  "pm.test(\"Two eligible crafting workers\", () => {",
                  "  pm.expect(replicas).to.have.lengthOf.at.least(2);",
                  "  replicas.forEach(instance => {",
                  "    pm.expect(instance.grpc_url).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(instance.topics).to.include(\"commands.crafting\");",
                  "    pm.expect(instance.load).to.be.a(\"number\");",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lab 5 - read recipe catalogue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Cache-Control",
                "value": "max-age=30"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Gateway identified a cache shard\", () => {",
                  "  pm.expect([\"HIT\", \"MISS\"]).to.include(pm.response.headers.get(\"X-PAD-Cache\"));",
                  "  pm.expect(pm.response.headers.get(\"X-PAD-Cache-Shard\")).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.variables.set(\"lab5CacheShard\", pm.response.headers.get(\"X-PAD-Cache-Shard\"));",
                  "pm.variables.set(\"lab5CacheBody\", pm.response.text());"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Lab 5 - repeat recipe catalogue on the same shard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Cache-Control",
                "value": "max-age=30"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/recipes",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Repeat is a HIT on the same shard\", () => {",
                  "  pm.expect(pm.response.headers.get(\"X-PAD-Cache\")).to.eql(\"HIT\");",
                  "  pm.expect(pm.response.headers.get(\"X-PAD-Cache-Shard\")).to.eql(pm.variables.get(\"lab5CacheShard\"));",
                  "  pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.variables.get(\"lab5CacheBody\")));",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Lab 5 - find this job in the Broker journal",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{brokerAdminToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{broker}}/v1/sagas",
            "description": "User REST enters Gateway. Uncached business calls use Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const job = pm.response.json().sagas.find(row => row.job_id === pm.environment.get(\"jobId\"));",
                  "pm.test(\"Broker completed the same job using the selected protocol\", () => {",
                  "  pm.expect(job).to.be.an(\"object\");",
                  "  pm.expect(job.protocol).to.eql(pm.environment.get(\"craftProtocol\") || \"saga\");",
                  "  pm.expect(job.state).to.eql(\"done\");",
                  "  pm.expect(job.request_id).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}

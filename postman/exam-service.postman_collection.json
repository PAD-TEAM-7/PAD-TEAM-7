{
  "info": {
    "name": "PAD TEAM 7 — Exam Service",
    "description": "Exam Service (section 3 of the CPR README), reached through the API gateway on :8080 (Lab 2). Run the folders in order (Collection Runner works).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{player_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "player_username",
      "value": ""
    },
    {
      "key": "other_username",
      "value": ""
    },
    {
      "key": "player_id",
      "value": ""
    },
    {
      "key": "other_player_id",
      "value": ""
    },
    {
      "key": "player_token",
      "value": ""
    },
    {
      "key": "other_player_token",
      "value": ""
    },
    {
      "key": "service_token",
      "value": ""
    },
    {
      "key": "lobby_id",
      "value": "lobby-postman"
    },
    {
      "key": "exam_id",
      "value": ""
    },
    {
      "key": "question_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health (prefixed route)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": {
          "raw": "{{gateway_url}}/exam-service/api/v1/health",
          "host": [
            "{{gateway_url}}"
          ],
          "path": [
            "exam-service",
            "api",
            "v1",
            "health"
          ]
        }
      }
    },
    {
      "name": "Ready (checks the database)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('ready', () => pm.expect(pm.response.json().status).to.eql('ready'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": {
          "raw": "{{gateway_url}}/exam-service/api/v1/ready",
          "host": [
            "{{gateway_url}}"
          ],
          "path": [
            "exam-service",
            "api",
            "v1",
            "ready"
          ]
        }
      }
    },
    {
      "name": "0. Auth (through the gateway)",
      "description": "Run first: the tokens are stored as collection variables and used by every other request.",
      "item": [
        {
          "name": "Register player",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('player_username', 'player_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{player_username}}\",\n  \"email\": \"{{player_username}}@faf.university\",\n  \"password\": \"correct-horse-battery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/players/register",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "players",
                "register"
              ]
            }
          }
        },
        {
          "name": "Log in player (real RS256 token from Player Service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('player_id', body.player_id);",
                  "pm.collectionVariables.set('player_token', body.access_token);"
                ]
              }

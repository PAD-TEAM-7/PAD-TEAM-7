                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/players/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "players",
                "login"
              ]
            }
          }
        },
        {
          "name": "Register other",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('other_username', 'other_' + Date.now());"

                "courses"
              ]
            }
          }
        },
        {
          "name": "Math courses only",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('only Math', () => pm.response.json().items.forEach(c => pm.expect(c.department).to.eql('Math')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],

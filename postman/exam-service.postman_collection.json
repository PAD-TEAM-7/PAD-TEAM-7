                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('10 courses', () => pm.expect(pm.response.json().items).to.have.lengthOf(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/courses",

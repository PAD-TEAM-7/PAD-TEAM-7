    {
      "name": "1. Courses",
      "item": [
        {
          "name": "Course catalogue",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('10 courses', () => pm.expect(pm.response.json().items).to.have.lengthOf(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{exam_url}}/courses",
              "host": [
                "{{exam_url}}"
              ],
              "path": [
                "courses"
              ]
            }
          }
        },
        {
          "name": "Math courses only",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('only Math', () => pm.response.json().items.forEach(c => pm.expect(c.department).to.eql('Math')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],

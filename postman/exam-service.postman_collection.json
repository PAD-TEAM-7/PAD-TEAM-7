{
  "info": {
    "name": "PAD Lab 4 - exam-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Current Lab 4 deployment (Gateway 28080, Broker 28601, Discovery 28500). FIRST run scripts/lab4-prepare-postman.py and import its PRIVATE environment. Run folders in order. Regenerate fixtures before repeating a collection. All requests assert their expected status. Removed service-only Gateway routes deliberately expect 404. Native gRPC examples: postman/grpc/README.md. Never export real environment credentials into Git."
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:28080"
    },
    {
      "key": "broker",
      "value": "http://localhost:28601"
    },
    {
      "key": "discovery",
      "value": "http://localhost:28500"
    }
  ],
  "item": [
    {
      "name": "exam-service",
      "item": [
        {
          "name": "01 Course catalogue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/courses",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Courses enrolled by PlayerRegistered topic",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/players/{{playerId}}/courses",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Real asynchronous enrolment\", () => pm.expect(pm.response.json().items).to.be.an(\"array\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Read prepared exam",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/exams/{{examId}}",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Ten questions\", () => pm.expect(pm.response.json().questions).to.have.lengthOf(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Save answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/exams/{{examId}}/answers",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_id\": \"{{questionId}}\",\n  \"option_index\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Submit exam",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{examSubmitKey}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/exams/{{examId}}/submit",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"examSubmitKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"examSubmitResult\", JSON.stringify(pm.response.json()));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Replay submit - identical outcome",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{examSubmitKey}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/exams/{{examId}}/submit",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Exactly same submit result\", () => pm.expect(JSON.stringify(pm.response.json())).to.eql(pm.environment.get(\"examSubmitResult\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Exam history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/players/{{playerId}}/exams?limit=10",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Achievements",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/players/{{playerId}}/achievements",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Diploma progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/players/{{playerId}}/diploma",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Other player cannot view this exam",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{otherPlayerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/exams/{{examId}}",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Issue exam is service-only (removed: 404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/exams",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Gateway removed route\", () => pm.expect(pm.response.json().error.code).to.eql(\"ROUTE_NOT_FOUND\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Internal passed-course lookup (removed: 404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gateway}}/api/v1/players/{{playerId}}/passed",
            "description": "Lab 4: user REST enters Gateway; Gateway dispatches through Broker gRPC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Gateway removed route\", () => pm.expect(pm.response.json().error.code).to.eql(\"ROUTE_NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}

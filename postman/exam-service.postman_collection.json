{
  "info": {
    "name": "PAD TEAM 7 — Exam Service",
    "description": "Exam Service (port 8003) — see section 3 of the CPR README. Run the folders in order (Collection Runner works). Needs AUTH_DEV_TOKENS=true for the test tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{player_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "exam_url",
      "value": "http://localhost:8080/exam-service/api/v1"
    },
    {
      "key": "player_id",
      "value": "player-postman"
    },
    {
      "key": "lobby_id",
      "value": "lobby-postman"
    },
    {
      "key": "player_token",
      "value": ""
    },
    {
      "key": "other_player_token",
      "value": ""
    },
    {
      "key": "service_token",
      "value": ""
    },
    {
      "key": "exam_id",
      "value": ""
    },
    {
      "key": "question_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": {
          "raw": "{{exam_url}}/health",
          "host": [
            "{{exam_url}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "0. Auth (test tokens)",
      "description": "Run first. Tokens are stored as collection variables and used by every other request.",
      "item": [
        {
          "name": "Player token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('player_token', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"player\",\n  \"sub\": \"{{player_id}}\",\n  \"username\": \"undead_survivor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{exam_url}}/dev/tokens",
              "host": [
                "{{exam_url}}"
              ],
              "path": [
                "dev",
                "tokens"
              ]
            },
            "description": "Stand-in for Player Service login (AUTH_DEV_TOKENS=true). Stores {{player_token}}."
          }
        },
        {
          "name": "Other player token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('other_player_token', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"player\",\n  \"sub\": \"someone-else\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{exam_url}}/dev/tokens",
              "host": [
                "{{exam_url}}"
              ],
              "path": [
                "dev",
                "tokens"
              ]
            }
          }
        },
        {
          "name": "Service token (as game-service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('service_token', pm.response.json().access_token);"
                ]
              }
            }

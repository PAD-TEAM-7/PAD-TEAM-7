    {
      "name": "2. Exam flow",
      "item": [
        {
          "name": "Issue exam (Game Service)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh player every run, so the flow never hits EXAM_ALREADY_ACTIVE or a passed course.",
                  "pm.collectionVariables.set('player_id', 'player-' + Date.now());",
                  "pm.sendRequest({ url: pm.collectionVariables.get('exam_url') + '/dev/tokens', method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ kind: 'player', sub: pm.collectionVariables.get('player_id') }) } },",
                  "  (err, res) => pm.collectionVariables.set('player_token', res.json().access_token));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const exam = pm.response.json();",
                  "pm.collectionVariables.set('exam_id', exam.exam_id);",
                  "pm.test('10 questions, 6 to pass', () => { pm.expect(exam.question_count).to.eql(10); pm.expect(exam.passing_score).to.eql(6); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{service_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{player_id}}\",\n  \"lobby_id\": \"{{lobby_id}}\",\n  \"encounter_id\": \"encounter-{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{exam_url}}/exams",
              "host": [
                "{{exam_url}}"
              ],
              "path": [
                "exams"
              ]
            },
            "description": "Idempotency-Key is a fresh {{$guid}}. Omit course_id to let the service pick one."
          }
        },
        {
          "name": "Issue a second exam → 409 EXAM_ALREADY_ACTIVE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code EXAM_ALREADY_ACTIVE', () => pm.expect(pm.response.json().error.code).to.eql('EXAM_ALREADY_ACTIVE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{service_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{player_id}}\",\n  \"lobby_id\": \"{{lobby_id}}\",\n  \"encounter_id\": \"encounter-2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{exam_url}}/exams",
              "host": [
                "{{exam_url}}"
              ],
              "path": [
                "exams"
              ]
            }
          }
        },
        {
          "name": "Get exam",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const exam = pm.response.json();",
                  "pm.collectionVariables.set('question_id', exam.questions[0].question_id);",
                  "pm.test('never leaks answers', () => pm.expect(pm.response.text()).not.to.include('correct_option'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{exam_url}}/exams/{{exam_id}}",
              "host": [
                "{{exam_url}}"
              ],
              "path": [
                "exams",
                "{{exam_id}}"
              ]
            }
          }
        },
        {
          "name": "Save an answer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('answered 1 of 10', () => pm.expect(pm.response.json().answered_count).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_id\": \"{{question_id}}\",\n  \"option_index\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{exam_url}}/exams/{{exam_id}}/answers",
              "host": [
                "{{exam_url}}"
              ],
              "path": [
                "exams",
                "{{exam_id}}",
                "answers"
              ]
            }
          }
        },
        {
          "name": "Another player reads it → 403 NOT_YOUR_EXAM",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403', () => pm.response.to.have.status(403));",
                  "pm.test('error code NOT_YOUR_EXAM', () => pm.expect(pm.response.json().error.code).to.eql('NOT_YOUR_EXAM'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{other_player_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{exam_url}}/exams/{{exam_id}}",
              "host": [
                "{{exam_url}}"
              ],
              "path": [
                "exams",
                "{{exam_id}}"
              ]
            }
          }
        },
        {
          "name": "Submit and grade",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('graded', () => { pm.expect(r.grade).to.be.within(1, 10); pm.expect(r.passed).to.be.a('boolean'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{exam_url}}/exams/{{exam_id}}/submit",
              "host": [
                "{{exam_url}}"
              ],
              "path": [
                "exams",
                "{{exam_id}}",
                "submit"
              ]
            }
          }
        },
        {
          "name": "Submit again → 422 EXAM_ALREADY_SUBMITTED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('error code EXAM_ALREADY_SUBMITTED', () => pm.expect(pm.response.json().error.code).to.eql('EXAM_ALREADY_SUBMITTED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{exam_url}}/exams/{{exam_id}}/submit",
              "host": [
                "{{exam_url}}"
              ],
              "path": [
                "exams",
                "{{exam_id}}",
                "submit"
              ]
            }
          }
        }
      ]
    },

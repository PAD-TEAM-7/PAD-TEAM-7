# Copy to .env and replace every change_me. .env is git-ignored — never commit real secrets.

# Shared by every service: signs service-to-service tokens (HS256).
SERVICE_JWT_SECRET=change_me
# Lab 2: signs the identity the API gateway hands to services instead of the token (X-Auth-*
# headers). At least 32 characters, the same value for the gateway and every service.
GATEWAY_IDENTITY_SECRET=change_me_to_a_long_random_value_32+

# Player tokens. While Player Service is not deployed, leave PLAYER_JWKS_URL empty: tokens are then
# mocked (HS256 with MOCK_PLAYER_JWT_SECRET) and POST /api/v1/dev/tokens issues test tokens.
PLAYER_JWKS_URL=
MOCK_PLAYER_JWT_SECRET=change_me
AUTH_DEV_TOKENS=true

# One private database per service.
PLAYER_DB_USER=player
PLAYER_DB_PASSWORD=change_me
GAME_DB_USER=game
GAME_DB_PASSWORD=change_me
EXAM_DB_USER=exam
EXAM_DB_PASSWORD=change_me
WORLD_DB_USER=world
WORLD_DB_PASSWORD=change_me
BASE_DB_USER=base
BASE_DB_PASSWORD=change_me
CRAFTING_DB_USER=crafting
CRAFTING_DB_PASSWORD=change_me
ZOMBIE_DB_USER=zombie
ZOMBIE_DB_PASSWORD=change_me
RESOURCE_DB_USER=resource
RESOURCE_DB_PASSWORD=change_me

# Image versions (DockerHub tags).
GATEWAY_VERSION=2.1.0
PLAYER_SERVICE_VERSION=2.0.1
GAME_SERVICE_VERSION=2.0.1
EXAM_SERVICE_VERSION=2.0.0
WORLD_SERVICE_VERSION=2.0.0
BASE_SERVICE_VERSION=2.0.0
CRAFTING_SERVICE_VERSION=2.0.0
ZOMBIE_SERVICE_VERSION=1.0.0
RESOURCE_SERVICE_VERSION=1.0.0

# Service URLs: every service reaches the others through the API gateway (Lab 2). The defaults in
# docker-compose.yml already do this (http://gateway:8080/<service>); set a value here only to
# bypass the gateway while debugging one service.
#PLAYER_SERVICE_URL=http://gateway:8080/player-service
#RESOURCE_SERVICE_URL=http://gateway:8080/resource-service
ACTION_TIME_SCALE=0.01

# Player and Game service-owned limits (Lab 2 grade 8).
PLAYER_TASK_TIMEOUT_SECONDS=15
PLAYER_MAX_CONCURRENT_REQUESTS=100
GAME_TASK_TIMEOUT_SECONDS=15
GAME_MAX_CONCURRENT_REQUESTS=100

# Gateway settings.
GAME_WS_PUBLIC_URL=ws://localhost:8002
GATEWAY_LOG_LEVEL=info
GATEWAY_CONNECT_TIMEOUT_SECONDS=2
GATEWAY_UPSTREAM_TIMEOUT_SECONDS=10
GATEWAY_UPSTREAM_MAX_CONNECTIONS=200
GATEWAY_MAX_REQUEST_BODY_BYTES=1048576
GATEWAY_TASK_TIMEOUT_SECONDS=15
GATEWAY_MAX_CONCURRENT_REQUESTS=100
GATEWAY_MAX_CONCURRENT_PER_SERVICE=50
GATEWAY_DEBUG_ENDPOINTS=false
# POST /gateway/dev/tokens issues service tokens for the Postman collections. Local testing only.
GATEWAY_DEV_TOKENS=true
# Temporary migration list: services that still verify tokens themselves keep receiving the token.
# Grade 10 is complete when it is empty: remove a service once it trusts the X-Auth-* headers
# (docs/lab2-gateway-migration.md). An empty list today makes the gateway strip the token from the
# 1.0.0 images of these services, which then answer 401 to every authenticated request.
GATEWAY_LEGACY_AUTH_SERVICES=zombie-service,resource-service,base-service,crafting-service

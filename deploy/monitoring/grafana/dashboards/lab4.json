{
  "uid": "pad-lab4",
  "title": "PAD Lab 4: Broker, queues and service health",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "PAD",
    "Lab4"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Deliveries per second",
      "datasource": {
        "type": "prometheus",
        "uid": "pad-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,outcome) (rate(broker_deliveries_total[1m]))",
          "legendFormat": "{{service}} {{instance}} {{state}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Delivery p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "pad-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,service) (rate(broker_delivery_seconds_bucket[2m])))",
          "legendFormat": "{{service}} {{instance}} {{state}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Durable queue states",
      "datasource": {
        "type": "prometheus",
        "uid": "pad-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "broker_queue_messages",
          "legendFormat": "{{service}} {{instance}} {{state}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active broker deliveries",
      "datasource": {
        "type": "prometheus",
        "uid": "pad-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "broker_delivery_inflight",
          "legendFormat": "{{service}} {{instance}} {{state}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Observed service replica load",
      "datasource": {
        "type": "prometheus",
        "uid": "pad-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "broker_instance_load",
          "legendFormat": "{{service}} {{instance}} {{state}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Eligible service replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "pad-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (broker_instance_eligible)",
          "legendFormat": "{{service}} {{instance}} {{state}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Circuit exclusions in 15 minutes",
      "datasource": {
        "type": "prometheus",
        "uid": "pad-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (increase(broker_circuit_open_total[15m]))",
          "legendFormat": "{{service}} {{instance}} {{state}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Discovery snapshot age",
      "datasource": {
        "type": "prometheus",
        "uid": "pad-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "broker_registry_snapshot_age_seconds",
          "legendFormat": "{{service}} {{instance}} {{state}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
